{
  "contractId": "D-001",
  "contractVersion": "1.0.0",
  "packageId": "presentation-control-assurance",
  "packageVersion": "1.2.1",
  "title": "Governed source assurance",
  "purpose": "Demonstrate environment-scoped identity and robust semantic portal orchestration before governed source intake, using synthetic information only.",
  "publisher": "public-purpose-lab",
  "releasedAt": "2026-09-01T11:00:00Z",
  "informationProfile": "synthetic-only",
  "permittedProfiles": [
    "native-development",
    "local-containers",
    "minikube",
    "private-hosted-smoke",
    "managed-hosted"
  ],
  "surfaceSlots": [
    {
      "slotId": "audience-display",
      "role": "audience-display",
      "required": true,
      "supportedViews": ["pres-intro", "pres-progress"]
    },
    {
      "slotId": "reviewer-workbench",
      "role": "reviewer-workbench",
      "required": false,
      "supportedViews": ["wb-engagement", "wb-source-intake"]
    }
  ],
  "stages": [
    {
      "stageId": "environment-and-identities",
      "title": "Environment and identities",
      "steps": [
        {
          "stepId": "prepare",
          "kind": "lifecycle",
          "description": "Prepare the synthetic demonstration session.",
          "operation": "prepare"
        },
        {
          "stepId": "assign-reviewer",
          "kind": "checkpoint",
          "description": "Establish the bounded synthetic reviewer application session.",
          "target": "reviewer-workbench"
        }
      ]
    },
    {
      "stageId": "portal-orchestration",
      "title": "Scenario introduction and portal orchestration",
      "steps": [
        {
          "stepId": "start",
          "kind": "lifecycle",
          "description": "Start the prepared session.",
          "operation": "start"
        },
        {
          "stepId": "show-introduction",
          "kind": "presentation-cue",
          "description": "Ask the presentation surface to show the admitted scenario introduction.",
          "target": "audience-display",
          "semanticView": "pres-intro"
        },
        {
          "stepId": "open-engagement-context",
          "kind": "presentation-cue",
          "description": "Ask the reviewer workbench to resolve the synthetic engagement context.",
          "target": "reviewer-workbench",
          "semanticView": "wb-engagement"
        },
        {
          "stepId": "open-source-intake",
          "kind": "presentation-cue",
          "description": "Ask the reviewer workbench to show source-intake controls without performing a business operation.",
          "target": "reviewer-workbench",
          "semanticView": "wb-source-intake"
        },
        {
          "stepId": "pause",
          "kind": "lifecycle",
          "description": "Pause Director sequencing without changing component-owned state.",
          "operation": "pause"
        },
        {
          "stepId": "stop",
          "kind": "lifecycle",
          "description": "Stop the demonstration session and terminate synthetic bindings.",
          "operation": "stop"
        },
        {
          "stepId": "reset",
          "kind": "control",
          "description": "Reset component-owned disposable state and create a successor session.",
          "operation": "reset"
        }
      ]
    }
  ],
  "controls": {
    "logicalTime": {
      "mode": "manual-step",
      "initialInstant": "2030-01-01T09:00:00Z",
      "maximumAdvanceSeconds": 86400
    },
    "resetTargets": [
      "director-control-baseline",
      "presentation-registry-baseline"
    ],
    "faultProfiles": ["presentation-cue-delay"]
  },
  "limitations": [
    "Synthetic development assurance only.",
    "Presentation progress is not business completion or compliance evidence.",
    "Gate B does not create an engagement or receive, stage or process a source.",
    "Managed hosted use requires the reviewed OIDC, workload identity, Cloud KMS, HTTPS, expiry and teardown bindings.",
    "Hosted operation remains supervised, activation-scoped and synthetic-only."
  ]
}
