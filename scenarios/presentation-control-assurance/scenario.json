{
  "contractId": "D-001",
  "contractVersion": "1.0.0",
  "packageId": "presentation-control-assurance",
  "packageVersion": "1.1.0",
  "title": "Presentation control assurance",
  "purpose": "Demonstrate semantic presentation control and conclusive presentation-progress evidence using synthetic information only.",
  "publisher": "public-purpose-lab",
  "releasedAt": "2026-08-28T16:00:00Z",
  "informationProfile": "synthetic-only",
  "permittedProfiles": ["native-development", "local-containers", "minikube", "private-hosted-smoke", "managed-hosted"],
  "surfaceSlots": [
    {
      "slotId": "audience-display",
      "role": "audience-display",
      "required": true,
      "supportedViews": ["assurance-welcome"]
    },
    {
      "slotId": "reviewer-workbench",
      "role": "reviewer-workbench",
      "required": false,
      "supportedViews": ["assurance-welcome"]
    }
  ],
  "stages": [
    {
      "stageId": "assurance-path",
      "title": "Presentation assurance path",
      "steps": [
        { "stepId": "prepare", "kind": "lifecycle", "description": "Prepare the synthetic demonstration session.", "operation": "prepare" },
        { "stepId": "start", "kind": "lifecycle", "description": "Start the prepared session.", "operation": "start" },
        { "stepId": "show-welcome", "kind": "presentation-cue", "description": "Ask the registered audience display to show the assurance welcome view.", "target": "audience-display", "semanticView": "assurance-welcome" },
        { "stepId": "confirm-presentation", "kind": "checkpoint", "description": "Evaluate the conclusive presentation-progress result.", "target": "audience-display" },
        { "stepId": "stop", "kind": "lifecycle", "description": "Stop the demonstration session.", "operation": "stop" },
        { "stepId": "reset", "kind": "control", "description": "Reset component-owned disposable state and create a successor session.", "operation": "reset" }
      ]
    }
  ],
  "controls": {
    "logicalTime": { "mode": "manual-step", "initialInstant": "2030-01-01T09:00:00Z", "maximumAdvanceSeconds": 86400 },
    "resetTargets": ["director-control-baseline", "presentation-registry-baseline"],
    "faultProfiles": ["presentation-cue-delay"]
  },
  "limitations": [
    "Synthetic development assurance only.",
    "Presentation progress is not business completion or compliance evidence.",
    "Managed hosted use requires the reviewed OIDC, workload identity, Cloud KMS, HTTPS, expiry and teardown bindings.",
    "Hosted operation remains supervised, activation-scoped and synthetic-only."
  ]
}
