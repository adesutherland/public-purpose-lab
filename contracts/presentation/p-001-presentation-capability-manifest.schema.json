{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:P-001:1.0.0",
  "title": "P-001 Presentation capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "manifestId",
    "manifestVersion",
    "applicationId",
    "applicationRelease",
    "surfaceRoles",
    "views",
    "informationProfiles",
    "releasedAt"
  ],
  "properties": {
    "contractId": { "const": "P-001" },
    "contractVersion": { "const": "1.0.0" },
    "manifestId": { "$ref": "#/$defs/id" },
    "manifestVersion": { "$ref": "#/$defs/version" },
    "applicationId": { "$ref": "#/$defs/id" },
    "applicationRelease": { "$ref": "#/$defs/version" },
    "surfaceRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["audience-display", "reviewer-workbench"] }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewId", "viewVersion", "contextKeys"],
        "properties": {
          "viewId": { "$ref": "#/$defs/id" },
          "viewVersion": { "$ref": "#/$defs/version" },
          "contextKeys": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "informationProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "const": "synthetic-only" }
    },
    "releasedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
