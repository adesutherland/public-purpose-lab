{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:P-002:1.0.0",
  "title": "P-002 Presentation surface registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "registrationId",
    "sessionId",
    "surfaceSlot",
    "surfaceRole",
    "manifestId",
    "manifestVersion",
    "supportedViews",
    "bindingMode",
    "registrationRevision",
    "connectionGeneration",
    "leaseExpiresAt"
  ],
  "properties": {
    "contractId": { "const": "P-002" },
    "contractVersion": { "const": "1.0.0" },
    "registrationId": { "$ref": "#/$defs/id" },
    "sessionId": { "$ref": "#/$defs/id" },
    "surfaceSlot": { "$ref": "#/$defs/name" },
    "surfaceRole": { "enum": ["audience-display", "reviewer-workbench"] },
    "manifestId": { "$ref": "#/$defs/name" },
    "manifestVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "supportedViews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "bindingMode": {
      "enum": [
        "pre-session",
        "external-session",
        "synthetic-session",
        "development-assurance"
      ]
    },
    "registrationRevision": { "type": "integer", "minimum": 1 },
    "connectionGeneration": { "type": "integer", "minimum": 1 },
    "leaseExpiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    }
  }
}
