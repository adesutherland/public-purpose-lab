{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:C-003:1.0.0",
  "title": "C-003 Command outcome and failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "outcomeId",
    "commandMessageId",
    "status",
    "code",
    "summary",
    "retryable",
    "completedAt",
    "evidence"
  ],
  "properties": {
    "contractId": { "const": "C-003" },
    "contractVersion": { "const": "1.0.0" },
    "outcomeId": { "$ref": "#/$defs/identifier" },
    "commandMessageId": { "$ref": "#/$defs/identifier" },
    "status": {
      "enum": ["accepted", "refused", "expired", "duplicate", "failed"]
    },
    "code": { "$ref": "#/$defs/code" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "retryable": { "type": "boolean" },
    "completedAt": { "type": "string", "format": "date-time" },
    "originalOutcomeId": { "$ref": "#/$defs/identifier" },
    "recoveryOwner": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "urn:public-purpose-lab:contract:C-004:1.0.0" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "duplicate" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "originalOutcomeId": true },
        "required": ["originalOutcomeId"]
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
