{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:C-002:1.0.0",
  "title": "C-002 Authority and purpose context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "environmentId",
    "requester",
    "roles",
    "delegatedAuthority",
    "purpose",
    "constraints",
    "policyVersion"
  ],
  "properties": {
    "contractId": { "const": "C-002" },
    "contractVersion": { "const": "1.0.0" },
    "environmentId": { "$ref": "#/$defs/identifier" },
    "requester": { "$ref": "#/$defs/principal" },
    "actor": { "$ref": "#/$defs/humanPrincipal" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authorityName" }
    },
    "delegatedAuthority": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authorityName" }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/authorityName" },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engagementIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "demonstrationSessionId": { "$ref": "#/$defs/identifier" },
        "targetComponents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{2,3}-[0-9]{2}$" }
        },
        "informationLevels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["public", "synthetic", "internal", "restricted-security"]
          }
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "decisionReference": { "$ref": "#/$defs/identifier" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "authorityName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalType", "principalId", "environmentId", "issuer"],
      "properties": {
        "principalType": {
          "enum": [
            "external-human",
            "synthetic-human",
            "workload",
            "operator",
            "service-owner"
          ]
        },
        "principalId": { "$ref": "#/$defs/identifier" },
        "environmentId": { "$ref": "#/$defs/identifier" },
        "issuer": { "$ref": "#/$defs/identifier" },
        "trustDomain": { "$ref": "#/$defs/identifier" }
      }
    },
    "humanPrincipal": {
      "allOf": [
        { "$ref": "#/$defs/principal" },
        {
          "type": "object",
          "properties": {
            "principalType": { "enum": ["external-human", "synthetic-human"] }
          }
        }
      ]
    }
  }
}
