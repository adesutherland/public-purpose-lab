{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:C-005:1.0.0",
  "title": "C-005 Component capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "componentId",
    "componentName",
    "releaseVersion",
    "maturity",
    "generatedAt",
    "supportedProfiles",
    "capabilities",
    "readinessDependencies",
    "evidence"
  ],
  "properties": {
    "contractId": { "const": "C-005" },
    "contractVersion": { "const": "1.0.0" },
    "componentId": { "$ref": "#/$defs/componentId" },
    "componentName": { "type": "string", "minLength": 3, "maxLength": 160 },
    "releaseVersion": { "$ref": "#/$defs/version" },
    "maturity": {
      "enum": ["repository-skeleton", "in-development", "demonstrated"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "supportedProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local-private",
          "portable-demonstration",
          "hosted-demonstrator",
          "development-assurance"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "description", "contracts"],
        "properties": {
          "capabilityId": { "$ref": "#/$defs/name" },
          "description": { "type": "string", "minLength": 3, "maxLength": 240 },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contractId", "versions"],
              "properties": {
                "contractId": {
                  "type": "string",
                  "pattern": "^[A-Z]{1,2}-[0-9]{3}$"
                },
                "versions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/version" }
                }
              }
            }
          }
        }
      }
    },
    "readinessDependencies": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "urn:public-purpose-lab:contract:C-004:1.0.0" }
    }
  },
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}-[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
