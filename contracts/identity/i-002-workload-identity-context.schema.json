{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:I-002:1.0.0",
  "title": "I-002 Workload identity context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "contextId",
    "environmentId",
    "issuer",
    "workloadId",
    "audiences",
    "contractActions",
    "attestationReference",
    "policyVersion",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "contractId": { "const": "I-002" },
    "contractVersion": { "const": "1.0.0" },
    "contextId": { "$ref": "#/$defs/id" },
    "environmentId": { "$ref": "#/$defs/id" },
    "issuer": { "$ref": "#/$defs/id" },
    "workloadId": { "$ref": "#/$defs/id" },
    "audiences": { "$ref": "#/$defs/ids" },
    "contractActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{1,3}-[0-9]{3}:[a-z][a-z0-9.-]{2,95}$"
      }
    },
    "attestationReference": { "$ref": "#/$defs/id" },
    "policyVersion": { "$ref": "#/$defs/version" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
