{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:I-004:1.0.0",
  "title": "I-004 Demonstration sign-in grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "claims", "signature"],
  "properties": {
    "contractId": { "const": "I-004" },
    "contractVersion": { "const": "1.0.0" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId",
        "establishmentOperationId",
        "environmentId",
        "trustDomain",
        "trustEpoch",
        "actorId",
        "applicationId",
        "audience",
        "surfaceId",
        "demonstrationSessionId",
        "roles",
        "purpose",
        "syntheticRealm",
        "decisionReference",
        "issuedAt",
        "notBefore",
        "expiresAt"
      ],
      "properties": {
        "grantId": { "$ref": "#/$defs/id" },
        "establishmentOperationId": { "$ref": "#/$defs/id" },
        "environmentId": { "$ref": "#/$defs/id" },
        "trustDomain": { "$ref": "#/$defs/id" },
        "trustEpoch": { "type": "integer", "minimum": 1 },
        "actorId": { "$ref": "#/$defs/id" },
        "applicationId": { "$ref": "#/$defs/id" },
        "audience": { "$ref": "#/$defs/id" },
        "surfaceId": { "$ref": "#/$defs/id" },
        "demonstrationSessionId": { "$ref": "#/$defs/id" },
        "roles": { "$ref": "#/$defs/names" },
        "purpose": { "$ref": "#/$defs/name" },
        "syntheticRealm": { "$ref": "#/$defs/id" },
        "decisionReference": { "$ref": "#/$defs/id" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "algorithm",
        "signerId",
        "publicKeyFingerprint",
        "value"
      ],
      "properties": {
        "profile": { "const": "ppl-i004-ed25519-v1" },
        "algorithm": { "const": "Ed25519" },
        "signerId": { "$ref": "#/$defs/id" },
        "publicKeyFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    }
  }
}
