{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:public-purpose-lab:contract:AZ-001:1.0.0",
  "title": "AZ-001 Authorisation decision and obligations",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/decision" }],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalType", "principalId", "environmentId", "issuer"],
      "properties": {
        "principalType": {
          "enum": [
            "external-human",
            "synthetic-human",
            "workload",
            "operator",
            "service-owner"
          ]
        },
        "principalId": { "$ref": "#/$defs/id" },
        "environmentId": { "$ref": "#/$defs/id" },
        "issuer": { "$ref": "#/$defs/id" },
        "trustDomain": { "$ref": "#/$defs/id" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "assertionType",
        "subjectId",
        "resourceId",
        "purposeCodes",
        "status",
        "effectiveAt",
        "expiresAt",
        "version"
      ],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "assertionType": {
          "enum": ["relationship", "consent", "restriction", "organisation"]
        },
        "subjectId": { "$ref": "#/$defs/id" },
        "resourceId": { "$ref": "#/$defs/id" },
        "purposeCodes": { "$ref": "#/$defs/names" },
        "status": { "enum": ["active", "revoked"] },
        "effectiveAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractVersion",
        "kind",
        "requestId",
        "environmentId",
        "requester",
        "actor",
        "action",
        "resource",
        "purpose",
        "requestedRoles",
        "assertions",
        "policyVersion",
        "requestedAt"
      ],
      "properties": {
        "contractId": { "const": "AZ-001" },
        "contractVersion": { "const": "1.0.0" },
        "kind": { "const": "decision-request" },
        "requestId": { "$ref": "#/$defs/id" },
        "environmentId": { "$ref": "#/$defs/id" },
        "requester": { "$ref": "#/$defs/principal" },
        "actor": { "$ref": "#/$defs/principal" },
        "action": { "$ref": "#/$defs/name" },
        "resource": { "$ref": "#/$defs/id" },
        "purpose": { "$ref": "#/$defs/name" },
        "requestedRoles": { "$ref": "#/$defs/names" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/assertion" }
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "requestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/name" },
        "value": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractVersion",
        "kind",
        "decisionId",
        "requestId",
        "status",
        "reasonCode",
        "obligations",
        "policyVersion",
        "decidedAt",
        "evidenceReferences"
      ],
      "properties": {
        "contractId": { "const": "AZ-001" },
        "contractVersion": { "const": "1.0.0" },
        "kind": { "const": "decision" },
        "decisionId": { "$ref": "#/$defs/id" },
        "requestId": { "$ref": "#/$defs/id" },
        "status": {
          "enum": ["permit", "deny", "not-applicable", "indeterminate"]
        },
        "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
        "obligations": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "decidedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "permit" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "obligations": { "type": "array", "minItems": 1 },
              "validUntil": true
            },
            "required": ["validUntil"]
          }
        }
      ]
    }
  }
}
